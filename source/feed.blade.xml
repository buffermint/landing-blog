@php
  // Atom feed of the blog: subscribe in a reader, or point an RSS-to-social service at it
  // (/feed.xml) to post new articles automatically
  $site = rtrim($page->baseUrl, '/');
  $abs = fn ($img) => preg_match('#^https?://#', $img) ? $img : $site . '/' . ltrim($img, '/');
  $latest = $posts->take(20);
@endphp
{!! '<' . '?xml version="1.0" encoding="utf-8"?' . '>' !!}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ $page->brand->name }} blog</title>
  <subtitle>{{ $page->brand->description }}</subtitle>
  <link href="{{ $site }}/articles" />
  <link rel="self" type="application/atom+xml" href="{{ $site }}/feed.xml" />
  <id>{{ $site }}/feed.xml</id>
  <icon>{{ $site }}/brand/logos/mark.png</icon>
  <updated>{{ date(DATE_ATOM, $latest->max(fn ($p) => $p->updated ?? $p->date)) }}</updated>
  <author><name>{{ $page->brand->name }}</name><uri>{{ $site }}</uri></author>
@foreach ($latest as $post)
  <entry>
    <title>{{ $post->title }}</title>
    <link href="{{ $post->getUrl() }}" />
    <id>{{ $post->getUrl() }}</id>
    <published>{{ date(DATE_ATOM, $post->date) }}</published>
    <updated>{{ date(DATE_ATOM, $post->updated ?? $post->date) }}</updated>
    <author><name>{{ $post->author }}</name></author>
    <summary>{{ $post->seo_description ?? $post->excerpt }}</summary>
@if ($post->featured_image)
    <link rel="enclosure" type="image/jpeg" href="{{ $abs($post->featured_image) }}" />
@endif
  </entry>
@endforeach
</feed>
